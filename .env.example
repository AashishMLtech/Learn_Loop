# ==========================================
# Learn Loop Environment
# ==========================================

# Groq API Configuration
# Note: Model IDs are intentionally left blank per rule 0.2. Populate with an active model ID from your Groq dashboard.
GROQ_API_KEY=
GROQ_MODEL=

# Authentication Secrets
API_KEY=default-insecure-api-key
ADMIN_API_KEY=default-admin-secret-xyz

# Storage Configuration (SQLite default; PostgreSQL compatible)
DATABASE_URL=sqlite:///./lesson_generator.db

# Operational Limits
RATE_LIMIT_PER_MINUTE=30
USE_PITFALL_HINTS=true

# Service Host & Port Bindings
API_HOST=0.0.0.0
API_PORT=8000
UI_PORT=8080
API_URL=http://127.0.0.1:8000
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
